# Script writing. Free tier, no credit card: console.groq.com -> API Keys.
# Going over the free limits returns an error, not a charge.
GROQ_API_KEY=

# Optional: competition scoring in topic discovery.
# Google Cloud Console -> enable "YouTube Data API v3" -> create an API key.
YOUTUBE_API_KEY=

# Instagram Reels posting. developers.facebook.com -> your app -> Use cases ->
# Instagram API -> API setup with Instagram login -> Generate token.
# Lasts 60 days; autoedits renews it into ig_token.json, so set it once.
INSTAGRAM_ACCESS_TOKEN=
